---
import Footer from '@/components/Footer.astro';
import Header from '@/components/Header.astro';
import {
  ICONS,
  JobTitle,
  MetaDescription,
  SiteName,
  SitePublicUrl,
  SocialLinks,
  ThemeColors,
  type SocialLink,
} from '@/utils/Constants.astro';
import '@styles/global.css';

interface Props {
  title?: string;
  description?: string;
  currentPage?: string;
  className?: string;
}

const { title = SiteName, description, currentPage, className } = Astro.props;

const siteVersion = import.meta.env.VITE_SITE_VERSION;
let sortedIcons = ICONS.sort().join(',');
const canonicalURL = Astro.url;
const defaultThemeColor = ThemeColors.brandNavy;
const ogImageURL = new URL('/assets/og-image.jpg', Astro.site);

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SiteName,
  jobTitle: JobTitle,
  url: SitePublicUrl,
  sameAs: [
    ...Object.values(SocialLinks).map((link: SocialLink) => link.url),
    'https://twitter.com/ahmedalshair',
  ],
  description: MetaDescription,
  knowsAbout: [
    'Product Strategy',
    'User Experience Design',
    'User Interface Design',
    'Frontend Development',
    'React',
    'Astro',
    'Svelte',
    'Typescript',
    'Javascript',
    'HTML',
    'CSS',
  ],
  knowsLanguage: ['en', 'ar'],
  image: `${SitePublicUrl}/assets/ahmed-alshair-photo.jpg`,
};
---

<html lang='en'>
  <head>
    <meta charset='utf-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1' />
    <meta name='generator' content={Astro.generator} />

    <link rel='canonical' href={canonicalURL} />
    <link rel='sitemap' href='/sitemap-index.xml' />

    <title>{title}</title>
    <meta name='description' content={description || MetaDescription} />

    <meta property='og:type' content='website' />
    <meta property='og:url' content={Astro.url || SitePublicUrl} />
    <meta property='og:title' content={title} />
    <meta property='og:description' content={description} />
    <meta property='og:image' content={ogImageURL} />
    <meta property='og:image:alt' content=`${SiteName} | ${JobTitle}` />

    <meta property='twitter:card' content='summary_large_image' />
    <meta property='twitter:url' content={Astro.url} />
    <meta property='twitter:title' content={title} />
    <meta property='twitter:description' content={description} />
    <meta property='twitter:image' content={ogImageURL} />
    <meta property='twitter:image:alt' content=`${SiteName} | ${JobTitle}` />

    <link rel='icon' type='image/svg+xml' href='/favicon.svg' />
    <meta name='theme-color' content={defaultThemeColor} />
    <meta name='version' content={siteVersion} />

    <link rel='preconnect' href='https://fonts.googleapis.com' />
    <link rel='preconnect' href='https://fonts.gstatic.com' crossorigin />
    <link
      href='https://fonts.googleapis.com/css2?family=Fira+Code:wght@300..700&family=Nunito+Sans:ital,opsz,wght@0,6..12,200..700;1,6..12,200..700&family=Space+Grotesk:wght@300..700&display=swap'
      rel='stylesheet'
    />
    <link
      href=`https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&icon_names=${sortedIcons}&display=block`
      rel='stylesheet'
    />

    <script is:inline>
      const theme =
        localStorage.getItem('theme') ||
        (window.matchMedia('(prefers-color-scheme: dark)').matches
          ? 'dark'
          : 'light');
      document.documentElement.setAttribute('data-theme', theme);
    </script>
  </head>

  <body id='root'>
    <Header currentPage={currentPage} />
    <main class:list={['full-bleed flex-layout column', className]}>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  body {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  main {
    flex-grow: 1;
    min-height: 100%;
  }
</style>

<script
  is:inline
  type='application/ld+json'
  set:html={JSON.stringify(personSchema)}
/>
