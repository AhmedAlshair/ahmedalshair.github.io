---
import ContactMeForm from '@/components/page-sections/ContactMeForm.svelte';
import BaseLayout from '@/layouts/BaseLayout.astro';
import {
  FormspreeId,
  SiteName,
  SocialLinks,
  type SocialLink,
} from '@/utils/Constants.astro';

const title = `Contact Me | ${SiteName}`;
const description = `Get in touch with me for any inquiries or collaborations.`;
---

<BaseLayout title={title} description={description}>
  <section
    id='social'
    class='on-social container padded flex-layout column gap gap-lg'
  >
    <h3>Find me on:</h3>

    <ul class='grid-layout three-cols gap'>
      {
        Object.values(SocialLinks).map((link: SocialLink) => (
          <li>
            <a
              class='social-link'
              href={link.url}
              target='_blank'
              rel='noopener noreferrer'
              aria-label={link.label}
            >
              {<link.icon />}
              <span>{link.label}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section id='form' class='contact-form flex-layout column gap gap-lg'>
    <h3 class='container padded'>Send me a message:</h3>
    <ContactMeForm
      formId={FormspreeId}
      client:load
      className='container padded'
    />
  </section>
</BaseLayout>

<style>
  .on-social {
    padding-block-start: var(--space-xl);
    padding-block-end: var(--space-xl);

    .social-link {
      height: 100%;
      padding: var(--space-md);
      display: flex;
      align-items: center;
      gap: var(--space-md);
      font-size: var(--font-size-h5);
      border: var(--stroke-width-thin) solid var(--border-color);

      svg {
        width: 1em;
        height: 1em;
        aspect-ratio: 1;
        fill: currentColor;
      }
    }
  }

  .contact-form {
    padding-block-start: var(--space-xl);
    padding-block-end: var(--space-xl);
    margin-block-end: var(--space-lg);
    background-color: var(--surface-1);

    h3 {
      margin-block-start: var(--space-md);
      margin-block-end: var(--space-md);
    }
  }
</style>
