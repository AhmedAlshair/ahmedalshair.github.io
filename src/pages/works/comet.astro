---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SiteName } from '@/utils/Constants.astro';
import { optimizeImages } from '@/utils/Helpers.astro';
import { Image } from 'astro:assets';
import WorkLayout, { type WorkSection } from '@/layouts/WorkLayout.astro';
import CometWorkCover from '@assets/works/comet/work-cover-comet.jpg';
import PharmaWorkCover from '@assets/works/pharma/work-cover-pharma.jpg';
import FindHomeWorkCover from '@assets/works/work-cover-findhome.jpg';
import CometOperator from '@assets/works/comet/comet-saas-carousel-1.png';
import CometParticipant from '@assets/works/comet/comet-saas-carousel-2.png';
import CometDashboard from '@assets/works/comet/comet-saas-carousel-4.png';
import CometWorkshop from '@assets/works/comet/comet-saas-carousel-5.png';
import CometSetup from '@assets/works/comet/comet-saas-carousel-6.png';
import CometReport from '@assets/works/comet/comet-saas-carousel-7.png';
import CometReportAppliances from '@assets/works/comet/comet-saas-carousel-9.png';
import CometOfflineInterfaces from '@assets/works/comet/comet-offline-2.png';
import CometFieldWorkshop from '@assets/works/comet/comet-offline-3.jpg';
import CometWorkshopCollage from '@assets/works/comet/comet-offline-carousel-5.jpg';
import ASULogo from '@assets/works/comet/asu-logo-light.svg';
import UNDPLogo from '@assets/works/comet/undp-logo-light.svg';
import Badge from '@/components/Badge.astro';
import Link from '@/components/links/Link.astro';
import ImageCarousel from '@/components/ImageCarousel.svelte';
import ImageViewer from '@/components/ImageViewer.svelte';
import ExploreMoreWorks from '@/components/page-sections/works/ExploreMoreWorks.astro';
import Icon from '@/components/Icon.svelte';

const title = `COMET: Designing & Building an Energy-Planning SaaS | Works | ${SiteName}`;
const description = `Leading COMET's UX/UI and frontend development: three years shaping a SaaS platform for collaborative energy planning, live simulation and reporting.`;

const sections: WorkSection[] = [
  { title: 'The Field Foundation', id: 'offline-toolkit' },
  { title: 'International Recognition', id: 'recognitions' },
  { title: 'Designing for SaaS', id: 'saas-transition' },
  { title: 'Frontend & System Design', id: 'hands-on' },
  { title: 'Making Data Understandable', id: 'decision-system' },
  { title: 'Outcomes & Growth', id: 'outcome' },
];

const [dashboard, workshop, setup] = await optimizeImages([
  CometDashboard,
  CometWorkshop,
  CometSetup,
]);
---

<BaseLayout title={title} description={description} currentPage='works'>
  <WorkLayout sections={sections}>
    <Image
      slot='work-image'
      src={CometWorkCover}
      alt='COMET: Community Energy Toolkit'
      loading='eager'
    />

    <Fragment slot='summary'>
      <div class='summary-head flex-layout column'>
        <span class='chapter-label'>COMET · 2020–Present</span>
        <h1>Designing & Building an Energy-Planning SaaS</h1>
        <p class='subtitle'>
          COMET helps energy professionals and communities explore how a
          mini-grid could serve their needs. I led its UX/UI and frontend
          evolution, with around three years dedicated to designing and building
          the SaaS platform: a connected experience for project preparation,
          live simulation and analysis.
        </p>
        <div class='badges flex-layout align-center justify-start wrap gap gap-sm'>
          <Badge text='Product Direction' />
          <Badge text='UX/UI Design' />
          <Badge text='Frontend Development' />
        </div>
      </div>

      <dl class='project-facts'>
        <div class='fact'>
          <dt>My role</dt>
          <dd>
            Primary UX/UI designer & frontend developer, shaping product
            direction
          </dd>
        </div>
        <div>
          <dt>Focus of this case study</dt>
          <dd>
            ~3 years of SaaS design and development, built on an earlier field
            toolkit
          </dd>
        </div>
        <div>
          <dt>Design to production</dt>
          <dd>Research, interaction design, reusable UI, React & TypeScript</dd>
        </div>
      </dl>

      <p class='credibility-note'>
        <span class='label'>Recognition & partnerships</span>
        <span class='note'>
          ASU field partnership · Featured by UNDP Digital X
        </span>
        <a class='inline-link' href='#recognitions'>
          Learn more
        </a>
      </p>

      <nav class='reading-guide' aria-label='Case study highlights'>
        <span>Explore the SaaS work</span>
        <a class='inline-link' href='#saas-transition'>
          Product & UI design
        </a>
        <a class='inline-link' href='#hands-on'>
          Frontend architecture
        </a>
        <a class='inline-link' href='#decision-system'>
          Reporting experience
        </a>
      </nav>
    </Fragment>

    <section
      id='offline-toolkit'
      class='container padded flex-layout column gap gap-lg'
    >
      <div class='section-intro'>
        <span class='chapter-label'>The foundation</span>
        <h2>Learning From the Field</h2>
      </div>
      <p>
        COMET began as an offline workshop tool. Expert interviews, prototyping
        and usability testing informed two synchronized interfaces: detailed
        controls for operators and visual appliance interactions for community
        participants with varying digital literacy. I designed these experiences
        and took ownership of the React frontend.
      </p>
      <div class='interface-pair offline-visuals'>
        <figure class='product-figure'>
          <a
            class='product-image-link offline-media workshop-photo link-wrapper'
            href={CometWorkshopCollage.src}
            data-image-viewer
            data-image-viewer-src={CometWorkshopCollage.src}
            data-image-viewer-alt='Photos of community members using COMET during energy-planning workshops'
            aria-label='Enlarge photos from COMET community workshops'
          >
            <Image
              src={CometFieldWorkshop}
              alt='A participant using COMET on a tablet during a community energy workshop'
              loading='lazy'
            />
          </a>
          <figcaption>
            <strong>Designing for participation</strong>
            Familiar appliance imagery and direct interactions helped make
            energy choices tangible for people with different levels of digital
            experience.
          </figcaption>
        </figure>
        <figure class='product-figure'>
          <a
            class='product-image-link offline-media with-background link-wrapper'
            href={CometOfflineInterfaces.src}
            data-image-viewer
            data-image-viewer-src={CometOfflineInterfaces.src}
            data-image-viewer-alt='COMET Offline interfaces: operator controls and load chart on a laptop, with visual participant appliance controls on a tablet'
            aria-label='Enlarge the COMET Offline interfaces'
          >
            <Image
              src={CometOfflineInterfaces}
              alt='COMET Offline interfaces: operator controls and load chart on a laptop, with visual participant appliance controls on a tablet'
              loading='lazy'
            />
          </a>
          <figcaption>
            <strong>Two roles, one shared experience</strong>
            Operators managed the simulation and monitored demand; participants
            explored household appliance choices and their effects.
          </figcaption>
        </figure>
      </div>
      <dl
        class='field-outcomes'
        aria-label='Outcomes of the offline product and workshop overhaul'
      >
        <div>
          <dt>Sites per project</dt>
          <dd>
            3 <span aria-label='increased to'>→</span> 70+
          </dd>
        </div>
        <div>
          <dt>Scenarios per workshop</dt>
          <dd>
            2–3 <span aria-label='increased to'>→</span> 8+
          </dd>
        </div>
      </dl>
      <p class='supporting-copy'>
        These outcomes followed the offline product and workshop overhaul. Local
        hardware, network setup and data handling still limited collaboration.
        That experience shaped the next challenge: bringing COMET into a shared
        cloud workspace.
      </p>
      <a
        class='inline-link align-self-start'
        href='https://www.behance.net/gallery/136257167/COMET-Product-Design'
        target='_blank'
        rel='noopener noreferrer'
      >
        Explore the earlier offline design process <Icon name={'open_in_new'} />
      </a>
    </section>

    <section
      id='recognitions'
      class='container padded flex-layout column gap gap-lg'
    >
      <div class='section-intro'>
        <span class='chapter-label'>International recognition & trust</span>
        <h2>Product Value Recognized Beyond the Workshop</h2>
      </div>
      <div class='recognition-grid'>
        <article class='recognition-card'>
          <div class='partner-logo' aria-hidden='true'>
            <ASULogo />
          </div>
          <span class='detail-label'>Field partnership</span>
          <h3>Arizona State University</h3>
          <p>
            ASU's Laboratory for Energy And Power Solutions partnered with COMET
            to help communities in Fiji understand mini-grid use. An evidence of
            the product's value in real energy-access projects.
          </p>
          <a
            class='inline-link'
            href='https://news.asu.edu/20240814-environment-and-sustainability-asu-lab-brings-energy'
            target='_blank'
            rel='noopener noreferrer'
          >
            Read the ASU feature <Icon name={'open_in_new'} />
          </a>
        </article>
        <article class='recognition-card'>
          <div class='partner-logo' aria-hidden='true'>
            <UNDPLogo />
          </div>
          <span class='detail-label'>International visibility</span>
          <h3>UNDP Digital X</h3>
          <p>
            Featured in UNDP's Digital X catalogue, COMET is highlighted for its
            role in supporting participatory energy planning and intuitive
            experiences for communities with limited digital exposure.
          </p>
          <a
            class='inline-link'
            href='https://digitalx.undp.org/catalogs/community-energy-toolkit-comet.html'
            target='_blank'
            rel='noopener noreferrer'
          >
            Explore the UNDP feature <Icon name={'open_in_new'} />
          </a>
        </article>
      </div>
    </section>

    <section
      id='saas-transition'
      class='saas-section flex-layout column gap gap-xl'
    >
      <div class='container padded flex-layout column gap gap-lg'>
        <div class='section-intro'>
          <span class='chapter-label'>01 · SaaS product & UI design</span>
          <h2>Designing for a Larger Product</h2>
        </div>
        <p class='section-lede'>
          The SaaS stage became my most substantial design and engineering
          undertaking. Over roughly three years, I expanded the workshop
          experience into a platform where teams could prepare projects,
          configure energy systems, run sessions and revisit their results.
        </p>
        <div class='decision-columns'>
          <article>
            <h3>Make the Structure Understandable</h3>
            <p>
              Projects, designs, workshops and simulations introduced layers of
              context. I shaped the information architecture around those
              relationships, using consistent navigation, contextual actions and
              reusable forms to help users understand where they were and what
              to do next.
            </p>
          </article>
          <article>
            <h3>Build a More Mature UI System</h3>
            <p>
              I refined typography, contrast, spacing and information hierarchy
              across dense dashboards and simpler participant screens. Semantic
              design tokens and reusable React components connected the visual
              system to production, including form validation, keyboard
              interactions and loading and error states.
            </p>
          </article>
        </div>
      </div>

      <ImageCarousel
        client:load
        objectFit='contain'
        images={[
          {
            url: dashboard.src,
            alt: 'Project dashboard: shared projects and consistent navigation give COMET a clear starting point.',
          },
          {
            url: workshop.src,
            alt: 'Workshop: simulations in their workshop context, connecting preparation to live sessions and results.',
          },
          {
            url: setup.src,
            alt: 'Forms: grouped configuration and reusable form controls make a complex task easier to work through.',
          },
        ]}
      />
    </section>

    <section
      id='hands-on'
      class='container padded flex-layout column gap gap-xl'
    >
      <div class='section-intro'>
        <span class='chapter-label'>
          02 · Frontend engineering & system design
        </span>
        <h2>Making a Shared Simulation Feel Coherent</h2>
      </div>
      <p>
        SaaS deepened my understanding of the system behind the interface: which
        data belongs to the server, which state belongs to the current screen,
        and how updates reach different users. I owned the React and TypeScript
        frontend and worked across API and real-time contracts to make those
        boundaries reliable.
      </p>

      <div class='interface-pair'>
        <figure class='product-figure'>
          <a
            class='product-image-link link-wrapper'
            href={CometOperator.src}
            data-image-viewer
            data-image-viewer-src={CometOperator.src}
            data-image-viewer-alt='COMET SaaS operator screen showing playback controls, participant connections, system status and a live load profile'
            aria-label='Enlarge the COMET operator screenshot'
          >
            <Image
              src={CometOperator}
              alt='COMET SaaS operator screen showing playback controls, participant connections, system status and a live load profile'
              loading='lazy'
            />
          </a>
          <figcaption>
            <strong>Operator: coordinate the room.</strong>
            Playback, connection status and system health sit above the detailed
            load profile so the session remains easy to monitor.
          </figcaption>
        </figure>
        <figure class='product-figure'>
          <a
            class='product-image-link link-wrapper'
            href={CometParticipant.src}
            data-image-viewer
            data-image-viewer-src={CometParticipant.src}
            data-image-viewer-alt='COMET SaaS participant screen showing rooms, appliance controls, energy use and tariff information'
            aria-label='Enlarge the COMET participant screenshot'
          >
            <Image
              src={CometParticipant}
              alt='COMET SaaS participant screen showing rooms, appliance controls, energy use and tariff information'
              loading='lazy'
            />
          </a>
          <figcaption>
            <strong>Participant: make everyday choices.</strong>
            Familiar appliances, visible on/off states and immediate energy
            feedback turn technical rules into tangible interactions.
          </figcaption>
        </figure>
      </div>

      <div class='decision-columns'>
        <article>
          <h3>Design the Interaction and Its Recovery</h3>
          <p>
            A participant's appliance choices affect the shared simulation while
            the operator controls its pace. I implemented synchronized updates,
            explicit session states and reconnect handling so a refresh or
            interrupted connection could restore the current session. Recovery
            became part of the interaction design.
          </p>
        </article>
        <article>
          <h3>Separate Responsibilities as the Product Grows</h3>
          <p>
            I separated reusable UI, live simulation state and server-data
            fetching. WebSocket updates support the shared session; cached
            queries support project workflows; report calculations sit outside
            presentation components. These boundaries made it easier to extend
            features and test behavior without duplicating logic across screens.
          </p>
        </article>
      </div>

      <aside class='engineering-note'>
        <strong>Architecture translated into user experience</strong>
        <p>
          Clear state ownership keeps controls and charts aligned. Reusable
          components keep interactions consistent. Coordinated caching keeps
          repeated navigation responsive while updates remain visible.
        </p>
      </aside>
    </section>

    <section id='decision-system' class='report-section'>
      <div class='container padded flex-layout column gap gap-xl'>
        <div class='section-intro'>
          <span class='chapter-label'>
            03 · Data visualization & frontend craft
          </span>
          <h2>Turning Results Into an Explorable Story</h2>
        </div>
        <p>
          COMET Reports brought together the design and engineering skills I
          developed through SaaS. The challenge was to make a dense simulation
          understandable at a glance while retaining the detail professionals
          need to investigate energy use, system performance and billing.
        </p>
        <div class='report-showcase'>
          <figure class='product-figure'>
            <a
              class='product-image-link link-wrapper'
              href={CometReportAppliances.src}
              data-image-viewer
              data-image-viewer-src={CometReportAppliances.src}
              data-image-viewer-alt='COMET simulation report showing appliance adoption, participant load profiles, appliance tables and a usage heatmap'
              aria-label='Enlarge the COMET report screenshot'
            >
              <Image
                src={CometReport}
                alt='COMET simulation report with summary metrics, analysis tabs, an interactive load profile and an events timeline'
                loading='lazy'
              />
            </a>
            <figcaption>
              Overview first, then investigation. Open the screenshot to inspect
              the report at full size.
            </figcaption>
          </figure>
          <div class='report-decisions'>
            <article>
              <span class='detail-label'>Visual hierarchy</span>
              <h3>Start With What Matters</h3>
              <p>
                I grouped energy, peak demand, reliability and unmet demand into
                a clear overview. Tabs separate system, billing, participant and
                appliance analysis, keeping the initial view focused.
              </p>
            </article>
            <article>
              <span class='detail-label'>Interaction design</span>
              <h3>Let Users Follow a Question</h3>
              <p>
                Users can move from community demand to individual participants
                and appliances, change time resolution and zoom into a period.
                Consistent scales and metric explanations help comparisons
                remain meaningful.
              </p>
            </article>
            <article>
              <span class='detail-label'>Frontend implementation</span>
              <h3>Keep Detail Responsive and Consistent</h3>
              <p>
                I separated data normalization and reusable analytics from
                rendering. Charts, tables and processed exports share the same
                report model, with caching and compatibility handling supporting
                repeat visits and older saved results.
              </p>
            </article>
          </div>
        </div>
      </div>
    </section>

    <section
      id='outcome'
      class='container padded flex-layout column gap gap-lg'
    >
      <div class='section-intro'>
        <span class='chapter-label'>Outcomes & growth</span>
        <h2>From Designing Screens to Shaping Systems</h2>
      </div>
      <p>
        The offline work established COMET's field value. SaaS expanded what I
        could design and build: a coherent product structure, a reusable UI
        system, synchronized experiences and an analytical frontend. Owning both
        design and implementation let me carry decisions through to working
        behavior and refine them against technical constraints.
      </p>
      <p>
        My biggest growth was learning to reason across the whole experience,
        from a participant's next action to the state and data that support it.
        COMET continues to evolve, with reporting and interaction quality
        remaining an active focus.
      </p>
      <div>
        <Link variant='secondary' href='/contact#form'>
          Let's work together
        </Link>
      </div>
    </section>
  </WorkLayout>

  <ImageViewer client:load />

  <ExploreMoreWorks
    works={[
      {
        title: 'Customized Digital Experiences for Pharma',
        image: PharmaWorkCover,
        linkUrl: '/works/pharma',
      },
      {
        title: 'FindHome: Accommodation Marketplace',
        image: FindHomeWorkCover,
        linkUrl:
          'https://www.behance.net/gallery/54932129/Find-Home-(Accomodation-Marketplace)',
        linkTarget: '_blank',
      },
    ]}
  />
</BaseLayout>

<style>
  .justify-self-start {
    justify-self: start;
  }

  .align-self-start {
    align-self: start;
  }

  .chapter-label,
  .detail-label {
    display: block;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: var(--font-size-h6);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .section-intro {
    display: grid;
    gap: var(--space-sm);
  }

  .project-facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-lg);
    padding-block-start: var(--space-lg);
    border-block-start: var(--stroke-width-thin) solid var(--border-color);

    dt {
      color: var(--text-muted);
      font-size: 0.9em;
      margin-block-end: var(--space-xs);
    }

    dd {
      font-weight: var(--font-weight-semibold);
    }
  }

  .reading-guide {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm) var(--space-lg);

    > span {
      color: var(--text-muted);
      font-size: 0.9em;
    }
  }

  .credibility-note {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-lg);
    padding-inline-start: var(--space-md);
    border-inline-start: var(--stroke-width-thick) solid var(--text-secondary);

    .label {
      color: var(--text-muted);
      font-size: 0.9em;
      width: 100%;
    }

    .note {
      color: var(--text-secondary);
    }
  }

  .offline-visuals {
    align-items: stretch;

    .offline-media {
      position: relative;
      width: 100%;
      aspect-ratio: 5 / 3;
      overflow: hidden;
    }

    .offline-media img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      border: none;
    }

    .workshop-photo img {
      object-fit: cover;
    }

    .with-background img {
      object-fit: contain;
      background-color: var(--surface-3);
      padding: var(--space-md);
    }
  }

  #recognitions {
    padding-block-start: 0;
  }

  .recognition-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-xl);
  }

  .recognition-card {
    display: flex;
    flex-direction: column;
    align-items: start;
    gap: var(--space-sm);
    min-width: 0;

    h3 {
      font-size: var(--font-size-h4);
      color: var(--text-secondary);
    }

    > a {
      margin-block-start: auto;
    }
  }

  .partner-logo {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 9rem;
    padding: var(--space-lg);
    margin-block-end: var(--space-sm);
    background-color: var(--surface-1);

    :global(svg) {
      width: 100%;
      max-width: 20rem;
      height: auto;
    }

    :global([data-theme='dark']) & {
      background-color: var(--surface-2);

      :global(path[fill='black']),
      :global(path[fill='#A30046']) {
        fill: white;
      }
    }
  }

  .field-outcomes {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-lg);
    padding: var(--space-lg);
    background-color: var(--surface-1);

    dt {
      color: var(--text-muted);
      margin-block-end: var(--space-xs);
    }

    dd {
      font-family: var(--font-headings);
      font-size: var(--font-size-h2);
      font-weight: var(--font-weight-bold);
      color: var(--text-secondary);
    }

    dd span {
      color: var(--text-muted);
      font-weight: var(--font-weight-regular);
    }
  }

  .supporting-copy,
  figcaption {
    color: var(--text-muted);
    font-size: 0.9em;
  }

  .saas-section,
  .report-section {
    background-color: var(--surface-1);
  }

  .saas-section {
    padding-block-end: 0;
  }

  .decision-columns,
  .interface-pair {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-xl);
  }

  .decision-columns article,
  .report-decisions article {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    min-width: 0;

    h3 {
      font-size: var(--font-size-h4);
      color: var(--text-secondary);
    }
  }

  .product-figure {
    min-width: 0;
    margin: 0;

    img {
      width: 100%;
      height: auto;
      object-fit: contain;
      border: var(--stroke-width-thin) solid var(--border-color);
    }

    figcaption {
      margin-block-start: var(--space-sm);
    }

    strong {
      display: block;
      color: var(--text-secondary);
      margin-block-end: var(--space-2xs);
    }
  }

  .engineering-note {
    padding: var(--space-lg);
    border-inline-start: var(--stroke-width-thick) solid var(--text-secondary);
    background-color: var(--surface-1);

    strong {
      display: block;
      margin-block-end: var(--space-xs);
      color: var(--text-secondary);
    }
  }

  .report-showcase {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: var(--space-xl);
    align-items: start;
  }

  .report-decisions {
    display: grid;
    gap: var(--space-lg);
  }

  .product-image-link {
    display: block;
    background-image: none;
    cursor: zoom-in;
  }

  section[id] {
    scroll-margin-block-start: calc(var(--header-height) + var(--space-lg));
  }

  @media (max-width: 900px) {
    .report-showcase {
      grid-template-columns: 1fr;
    }

    .report-decisions {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
