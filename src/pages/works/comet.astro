---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SiteName } from '@/utils/Constants.astro';
import { optimizeImages } from '@/utils/Helpers.astro';
import { Image } from 'astro:assets';
import WorkLayout, { type WorkSection } from '@/layouts/WorkLayout.astro';
import CometWorkCover from '@assets/works/comet/work-cover-comet.jpg';
import PharmaWorkCover from '@assets/works/pharma/work-cover-pharma.jpg';
import FindHomeWorkCover from '@assets/works/work-cover-findhome.jpg';
import MiniGridConceptLight from '@assets/works/comet/mini-grid-game-concept-light.jpg';
import CometOffline1 from '@assets/works/comet/comet-offline-1.png';
import CometOffline2 from '@assets/works/comet/comet-offline-2.png';
import CometOffline3 from '@assets/works/comet/comet-offline-3.jpg';
import CometOffline4 from '@assets/works/comet/comet-offline-4.png';
import CometOfflineCarousel1 from '@assets/works/comet/comet-offline-carousel-1.jpg';
import CometOfflineCarousel2 from '@assets/works/comet/comet-offline-carousel-2.jpg';
import CometOfflineCarousel3 from '@assets/works/comet/comet-offline-carousel-3.jpg';
import CometOfflineCarousel4 from '@assets/works/comet/comet-offline-carousel-4.jpg';
import CometOfflineCarousel5 from '@assets/works/comet/comet-offline-carousel-5.jpg';
import CometSaasCarousel1 from '@assets/works/comet/comet-saas-carousel-1.png';
import CometSaasCarousel2 from '@assets/works/comet/comet-saas-carousel-2.png';
import CometSaasCarousel3 from '@assets/works/comet/comet-saas-carousel-3.png';
import CometSaasCarousel4 from '@assets/works/comet/comet-saas-carousel-4.png';
import CometSaasCarousel5 from '@assets/works/comet/comet-saas-carousel-5.png';
import CometSaasCarousel6 from '@assets/works/comet/comet-saas-carousel-6.png';
import CometSaasCarousel7 from '@assets/works/comet/comet-saas-carousel-7.png';
import CometSaasCarousel8 from '@assets/works/comet/comet-saas-carousel-8.png';
import ASULogo from '@assets/works/comet/asu-logo-light.svg';
import UNDPLogo from '@assets/works/comet/undp-logo-light.svg';
import CometSaas1 from '@assets/works/comet/comet-saas-1.jpg';
import Badge from '@/components/Badge.astro';
import Icon from '@/components/Icon.svelte';
import DensityGrid from '@/components/charts/DensityGrid.svelte';
import BarChart from '@/components/charts/BarChart.svelte';
import Link from '@/components/links/Link.astro';
import ImageCarousel from '@/components/ImageCarousel.svelte';
import ExploreMoreWorks from '@/components/page-sections/works/ExploreMoreWorks.astro';

const title = `COMET: From Field Prototype to Living SaaS Platform | Works | ${SiteName}`;
const description = `A six-year product case study of leading COMET from an offline field prototype to a resilient, collaborative SaaS simulation and reporting platform.`;

let sections: WorkSection[] = [
  { title: 'From Concept to Field Tool', id: 'offline-toolkit' },
  { title: 'Designing for Field Reality', id: 'ux-challenge' },
  { title: 'Building the Offline System', id: 'hands-on-solution' },
  { title: 'Proven Impact & Recognition', id: 'redesign-impact' },
  { title: 'Re-architecting for SaaS', id: 'saas-transition' },
  { title: 'A Resilient Live Platform', id: 'hands-on' },
  { title: 'From Simulation to Decisions', id: 'decision-system' },
  { title: 'Stewardship & Road Ahead', id: 'outcome' },
];

const [
  optimizedOfflineCarousel1,
  optimizedOfflineCarousel2,
  optimizedOfflineCarousel3,
  optimizedOfflineCarousel4,
  optimizedOfflineCarousel5,
] = await optimizeImages([
  CometOfflineCarousel1,
  CometOfflineCarousel2,
  CometOfflineCarousel3,
  CometOfflineCarousel4,
  CometOfflineCarousel5,
]);

const [
  optimizedSaasCarousel1,
  optimizedSaasCarousel2,
  optimizedSaasCarousel3,
  optimizedSaasCarousel4,
  optimizedSaasCarousel5,
  optimizedSaasCarousel6,
  optimizedSaasCarousel7,
  optimizedSaasCarousel8,
] = await optimizeImages([
  CometSaasCarousel1,
  CometSaasCarousel2,
  CometSaasCarousel3,
  CometSaasCarousel4,
  CometSaasCarousel5,
  CometSaasCarousel6,
  CometSaasCarousel7,
  CometSaasCarousel8,
]);
---

<BaseLayout title={title} description={description} currentPage='works'>
  <WorkLayout sections={sections}>
    <Image
      slot='work-image'
      src={CometWorkCover}
      alt={'Comet: Community Energy Toolkit'}
      loading={'eager'}
    />

    <Fragment slot='summary'>
      <div class='summary-head flex-layout column'>
        <span class='chapter-label'>
          A continuing product story · 2020 - Present
        </span>
        <h2>From Field Experiment to Living Energy-Planning Platform</h2>
        <p class='subtitle'>
          I have led COMET across product direction, UX/UI design and frontend
          engineering as it evolved from a promising workshop concept into a
          collaborative SaaS platform. The work has spanned field research,
          interaction design, real-time simulation, product architecture,
          reporting and the continuity needed to keep a complex product moving
          through changing teams and requirements.
        </p>
        <div class='badges flex-layout align-center justify-start wrap gap gap-sm'>
          <Badge text='Product Direction' />
          <Badge text='UX/UI Design' />
          <Badge text='Frontend Engineering' />
          <Badge text='Product Quality' />
        </div>
      </div>

      <div class='role-summary grid-layout two-cols'>
        <div class='role'>
          <span class='label'>Core ownership:</span>
          <p>Product leadership, UX/UI design & frontend engineering</p>
        </div>
        <div class='date'>
          <span class='label'>Timeline:</span>
          <p>2020 - Present</p>
        </div>
        <div class='impact highlighted'>
          <span class='label'>Field outcomes:</span>
          <p>
            <span class='emphasized'>23x more site coverage</span> per
            deployment,
            <span class='emphasized'> 267% more scenarios</span> explored per
            workshop, and <span class='emphasized'>recognition by UNDP</span>.
          </p>
        </div>
        <div class='core-value highlighted'>
          <span class='label'>Continuing value:</span>
          <p>
            Preserving product logic and user trust while the platform, team and
            technical foundations continue to evolve.
          </p>
        </div>
      </div>

      <ol class='evolution-map' aria-label='COMET product evolution'>
        <li>
          <span class='phase-index'>01</span>
          <div>
            <a
              class='inline-link phase-label'
              href='#offline-toolkit'
              aria-label='Field toolkit'
            >
              Field toolkit
            </a>
            <p>
              Turn a raw idea into an inclusive, offline-first workshop tool.
            </p>
          </div>
        </li>
        <li>
          <span class='phase-index'>02</span>
          <div>
            <a
              class='inline-link phase-label'
              href='#saas-transition'
              aria-label='Cloud platform'
            >
              Cloud platform
            </a>
            <p>Remove the physical ceiling with secure, shared workflows.</p>
          </div>
        </li>
        <li class='current'>
          <span class='phase-index'>03</span>
          <div>
            <a
              class='inline-link phase-label'
              href='#decision-system'
              aria-label='Decision system'
            >
              Decision system
            </a>
            <p>
              Make every simulation durable, explainable and useful after the
              workshop.
            </p>
          </div>
        </li>
      </ol>
    </Fragment>

    <section
      id='offline-toolkit'
      class='container padded grid-layout horizontal two-cols gap gap-xl align-center'
    >
      <div class='content-wrapper flex-layout column gap gap-lg justify-center'>
        <span class='chapter-label'>Chapter 01 · The offline foundation</span>
        <h3>Professionalizing the Vision</h3>

        <p>
          At this stage, the{' '}
          <a
            href='https://solve.mit.edu/solutions/7223'
            target='_blank'
            rel='noopener noreferrer'
          >
            "Mini-grid Game" <Icon name='open_in_new' />
          </a>{' '}
          was an ambitious idea without the interaction model or technical
          reliability needed for real mini-grid planning. My first goal was to
          turn that concept into a{' '}
          <span class='emphasized'>
            credible, field-ready simulation toolkit
          </span>
          .
        </p>
        <p>
          Additionally, the workshop and deployment process depending on that
          concept were{' '}
          <span class='emphasized'>time-consuming and error-prone</span>, often
          requiring several days of manual setup and configuration. It also
          relied heavily on manual data collection and handling, limiting how
          many communities a project could reach.
        </p>
      </div>

      <Image
        src={MiniGridConceptLight}
        alt='The Mini-grid Game Concept'
        loading='lazy'
      />
    </section>

    <section
      id='evidence-based'
      class='container padded flex-layout column gap'
    >
      <h3>Evidence-Based Architecture</h3>
      <p>
        Transforming a conceptual “game” into a professional tool meant first
        understanding the decisions people needed to make. I used a structured,
        multi-phase design process to connect field realities, engineering logic
        and project goals before defining the interface.
      </p>

      <div
        id='design-process'
        class='content-wrapper padded grid-layout two-cols gap gap-xl align-center'
      >
        <div class='img-wrapper design-process'>
          <Image
            src={CometOffline1}
            alt='Comet Design Process'
            loading='lazy'
          />
        </div>

        <div class='content-wrapper flex-layout column gap align-start'>
          <p>
            <span class='emphasized'>Domain discovery:</span> I conducted expert
            interviews, stakeholder workshops and secondary research into
            mini-grid planning to understand the decisions the simulation had to
            support.
          </p>
          <p>
            <span class='emphasized'>Inclusive information architecture:</span>{' '}
            I mapped complex user flows for two distinct user groups (Operators
            vs. Participants), ensuring technical depth for professionals while
            maintaining clarity for community members.
          </p>

          <p>
            <span class='emphasized'>Iterative prototyping:</span> Moving from
            low-fidelity wireframes to interactive prototypes in{' '}
            <data value='Adobe XD' class='meta-label code' title='Adobe XD'>
              Adobe XD
            </data>{' '}
            and{' '}
            <data value='Figma' class='meta-label code' title='Figma'>
              Figma
            </data>{' '}
            let us test complex flows early and make the simulation tangible for
            stakeholders.
          </p>
          <p>
            <span class='emphasized'>Field-informed validation:</span> I led
            usability testing sessions to identify friction points in the
            simulation journey, directly informing the icon-heavy, color-coded
            UI that became a hallmark of COMET's accessibility.
          </p>
        </div>
      </div>

      <div class='content-wrapper flex-layout column gap align-start'>
        <p>
          Learn more about the Design Process and the detailed breakdown of the
          research methods and UI artifacts that built COMET Offline:
        </p>
        <Link
          variant='secondary'
          href='https://www.behance.net/gallery/136257167/COMET-Product-Design'
          target='_blank'
        >
          View the full Design Process
        </Link>
      </div>
    </section>

    <section id='ux-challenge' class='full-bleed flex-layout column gap gap-xl'>
      <div class='content-wrapper container padded flex-layout column gap'>
        <span class='chapter-label'>
          One simulation, two very different jobs
        </span>
        <h3>
          The UX Challenge: Designing for Zero Internet and Different Users
        </h3>
        <p>
          Software for off-grid contexts could not assume stable internet,
          individual devices or uniform digital literacy. The experience had to
          work as a local network ecosystem, keep a room of participants in sync
          and remain understandable when the technology itself disappeared into
          the background.
        </p>
      </div>

      <div class='content-wrapper flex-layout column'>
        <div class='grid-layout horizontal two-cols gap gap-xl align-center'>
          <div class='container-padded content-wrapper flex-layout column gap'>
            <h4>The Dual-Experience Logic</h4>
            <p>
              I designed two distinct but synchronized interfaces around the
              decisions each person needed to make.{' '}
              <span class='emphasized'>The Operator UI</span> coordinated the
              workshop and exposed system-level information, while the{' '}
              <span class='emphasized'>Participant UI</span> made household
              choices immediate and comprehensible for people with different
              levels of digital literacy.
            </p>
          </div>

          <div class='img-wrapper dual-experience'>
            <Image
              src={CometOffline2}
              alt='COMET UIs for Operators and Participants'
              loading='lazy'
            />
          </div>
        </div>

        <div class='grid-layout horizontal two-cols gap gap-xl align-center'>
          <Image
            src={CometOffline3}
            alt='A participant in a COMET workshop'
            loading='lazy'
          />
          <div class='container-padded content-wrapper flex-layout column gap'>
            <h4>Accessibility & Empathy</h4>
            <p>
              To ensure inclusivity for target users who mostly{' '}
              <a
                href='https://youtu.be/_JQu_1bGRDo?si=PQR5sXkgY2oeIx-7'
                target='_blank'
                rel='noopener noreferrer'
              >
                <span>live in remote villages and rural areas</span>
                <Icon name='open_in_new' />
              </a>
              , I prioritized an icon-heavy, color-coded interface that allowed
              non-technical users to understand and simulate their household
              energy needs. Multiple interaction methods reduced dependence on
              text and supported different levels of device familiarity.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section
      id='hands-on-solution'
      class='container padded flex-layout column gap'
    >
      <h3>Hands-on Craft: Building the Local Sync</h3>
      <p>
        The design could not stop at a prototype. As the primary frontend
        builder, I translated the operator and participant journeys into a
        working system and stayed close enough to the code to resolve the gap
        between intended behavior and field reality.
      </p>

      <div class='grid-layout horizontal two-cols gap gap-xl align-center'>
        <div class='content-wrapper flex-layout column gap gap-xl'>
          <div class='content-wrapper flex-layout column gap'>
            <h4>Design System Ownership</h4>
            <p>
              I created an evolving library of reusable components and styles in
              <data value='Adobe XD' class='meta-label code' title='Adobe XD'>
                Adobe XD
              </data>{' '}
              and{' '}
              <data value='Figma' class='meta-label code' title='Figma'>
                Figma
              </data>{' '}
              , from data-heavy charts to form inputs and interactive simulation
              "Room Appliances", ensuring visual consistency and accessibility
              across both the Operator and Participant platforms.
            </p>
            <p>
              The design language used semantic tokens and stayed connected to
              its frontend counterparts, reducing drift between design intent
              and production behavior.
            </p>
          </div>

          <div class='content-wrapper flex-layout column gap'>
            <h4>Frontend Architecture & Optimization</h4>
            <p>
              After guiding the initial frontend development, I took full
              ownership of the{' '}
              <data value='React' class='meta-label code' title='React'>
                React
              </data>{' '}
              codebase and steered it toward a dependable release. The priority
              was not novelty: it was performance, synchronization, simulation
              stability and error states people could understand in the middle
              of a workshop.
            </p>
          </div>
        </div>

        <div class='img-wrapper design-system'>
          <Image src={CometOffline4} alt='Comet Design System' loading='lazy' />
        </div>
      </div>
    </section>

    <ImageCarousel
      client:load
      objectFit='contain'
      images={[
        {
          url: optimizedOfflineCarousel1.src,
          alt: 'Simulation control UI for operators in COMET Offline',
        },
        {
          url: optimizedOfflineCarousel2.src,
          alt: 'Simulation UI for participants in COMET Offline',
        },
        {
          url: optimizedOfflineCarousel4.src,
          alt: 'Simulation billing UI for participants in COMET Offline',
        },
        {
          url: optimizedOfflineCarousel3.src,
          alt: 'Creating a Project in COMET Offline',
        },
        {
          url: optimizedOfflineCarousel5.src,
          alt: 'Photos from workshops in deployments using COMET',
        },
      ]}
    />

    <section
      id='redesign-impact'
      class='container padded flex-layout column gap gap-lg'
    >
      <h3>Results and Impact</h3>
      <p>
        The redesign changed what the team could deliver in the field, not only
        what the interface looked like. Following the product and technical
        overhaul, COMET achieved:
      </p>
      <ul class='impact-list grid-layout horizontal two-cols gap gap-xl'>
        <li class='flex-layout column gap'>
          <h5>23x Improvement in Efficiency</h5>
          <p>
            Average project coverage grew from 3 sites to more than 70, enabled
            by a more flexible workshop model and a tool that could be reused
            across locations.
          </p>
          <div class='chart-content'>
            <DensityGrid before={3} after={70} columns={7} />
          </div>
        </li>
        <li class='flex-layout column gap'>
          <h5>267% Increase in Simulations</h5>
          <p>
            Communities could explore 8+ energy scenarios per workshop, up from
            2–3, creating more room to compare trade-offs before committing to a
            plan.
          </p>
          <div class='chart-content'>
            <BarChart
              data={[
                { label: 'Before', value: 2 },
                { label: 'After', value: 8 },
              ]}
              width={300}
              gap={50}
            />
          </div>
        </li>
      </ul>
    </section>

    <section
      id='recognitions'
      class='container padded flex-layout column gap gap-lg'
    >
      <h3>Recognitions</h3>
      <p>
        This phase proved that a participatory energy-planning tool could be
        both technically useful to professionals and approachable to
        communities. It also established the product credibility and partner
        confidence needed for COMET's next stage.
      </p>

      <div class='content-wrapper grid-layout horizontal two-cols gap gap-xl wrap'>
        <div class='content-wrapper flex-layout column gap'>
          <p>
            The work helped establish trust with partners such as{' '}
            <a
              href='https://news.asu.edu/20240814-environment-and-sustainability-asu-lab-brings-energy'
              target='_blank'
              rel='noopener noreferrer'
            >
              Arizona State University <Icon name='open_in_new' />
            </a>{' '}
            and strengthened the case for the next leap: a cloud-based COMET.
          </p>

          <div class='partner-logo asu'>
            <ASULogo />
          </div>
        </div>

        <div class='content-wrapper flex-layout column gap'>
          <p>
            COMET was recognized by UNDP as an innovative solution and featured
            on{' '}
            <a
              href='https://digitalx.undp.org/catalogs/community-energy-toolkit-comet.html'
              target='_blank'
              rel='noopener noreferrer'
            >
              the UNDP Digital X platform <Icon name='open_in_new' />
            </a>{' '}
            and{' '}
            <a
              href='https://www.sdg-digital.org/sdg/affordable-and-clean-energy'
              target='_blank'
              rel='noopener noreferrer'
            >
              the UN SDG Acceleration Agenda <Icon name='open_in_new' />
            </a>
            .
          </p>
          <div class='partner-logo undp'>
            <UNDPLogo />
          </div>
        </div>
      </div>
    </section>

    <section id='pivot-point' class='pivot-point full-bleed'>
      <div class='pivot-point-content container padded flex-layout gap gap-xl align-center'>
        <h3 class='pivot-text'>
          <span class='slash'></span>
          <span>Pivot</span>
          <span>Point</span>
        </h3>

        <div class='content-wrapper padded flex-layout column gap'>
          <p>
            While COMET Offline achieved global recognition and measurable
            impact, our field evaluations revealed a growing barrier to scale.
            The LAN-based model had reached a physical ceiling: every deployment
            still carried local hardware, network setup, data-transfer risk and
            limited opportunities for teams to collaborate beyond the room.
          </p>
          <div class='hurdles flex-layout gap'>
            <span class='hurdle'>Hardware Dependencies</span>
            <span class='hurdle'>Network Instability</span>
            <span class='hurdle'>Local Data Loss</span>
            <span class='hurdle'>Collaboration Barriers</span>
          </div>
          <p>
            To ensure the product could truly scale to the global mini-grid
            market, I helped lead the product decision and experience strategy
            for <span class='emphasized'>COMET SaaS</span>,not a simple
            migration, but a rethinking of how projects, workshops, live
            simulations and results should work together.
          </p>
        </div>
      </div>
    </section>

    <section id='saas-transition' class='flex-layout column gap gap-xl'>
      <div class='container padded section-heading flex-layout column gap'>
        <span class='chapter-label'>
          Chapter 02 · Removing the physical ceiling
        </span>
        <h2>The SaaS Evolution</h2>
        <p class='section-lede'>
          The move to the cloud expanded COMET from a workshop application into
          a product ecosystem. It introduced persistent project data, secure
          access, remote preparation and a much larger responsibility: keeping
          every stage of a live multi-user simulation coherent.
        </p>
      </div>

      <div
        id='strategic-move'
        class='container padded content-wrapper flex-layout column gap'
      >
        <h3>Strategic Move: Solving for Scale</h3>
        <p>
          Research and a product/technical audit turned the field limitations
          into three non-negotiable goals for the next generation of COMET:
        </p>

        <ul class='grid-layout horizontal three-cols gap gap-xl'>
          <li class='flex-layout column gap'>
            <h5 class='emphasized'>Make Work Durable</h5>
            <p>
              Move project and simulation data out of a single local machine so
              teams could return to it, recover from interruptions and build on
              previous work with confidence.
            </p>
          </li>
          <li class='flex-layout column gap'>
            <h5 class='emphasized'>Reduce Deployment Friction</h5>
            <p>
              Remove the need to configure dedicated local hardware and LANs,
              using managed cloud services such as{' '}
              <a
                href='https://aws.amazon.com'
                target='_blank'
                rel='noopener noreferrer'
              >
                <span>AWS</span>
                <Icon name='open_in_new' />
              </a>{' '}
              to make preparation and access more flexible.
            </p>
          </li>
          <li class='flex-layout column gap'>
            <h5 class='emphasized'>Design for Collaboration</h5>
            <p>
              Connect organizations, projects, designs, workshops and
              participants in one workflow so preparation and learning could
              continue before and after a live session.
            </p>
          </li>
        </ul>
      </div>

      <div class='saas-hero full-bleed'>
        <Image
          src={CometSaas1}
          alt='COMET SaaS embraces collaboration over the cloud'
        />
      </div>

      <div
        id='product-custodian'
        class='container padded content-wrapper flex-layout column gap'
      >
        <h3>Maintaining Product Continuity</h3>
        <p>
          Rebuilding a domain-heavy product while the engineering team changed
          repeatedly created a second challenge: preserving the reasoning behind
          its behavior. Alongside my core product, design and frontend role, I
          stepped into backend, infrastructure and QA gaps when needed to
          protect delivery and keep the system understandable to each incoming
          team.
        </p>
        <ul class='stewardship-grid grid-layout horizontal three-cols gap gap-xl'>
          <li class='flex-layout column gap'>
            <span class='responsibility-label'>Core ownership</span>
            <h5 class='emphasized'>Product, UX & Frontend</h5>
            <p>
              I shaped product flows, translated domain rules into usable
              interactions and owned the React frontend that operators and
              participants depend on.
            </p>
          </li>
          <li class='flex-layout column gap'>
            <span class='responsibility-label'>Continuity system</span>
            <h5 class='emphasized'>Logic, Documentation & QA</h5>
            <p>
              I maintained product logic documentation, the user knowledge base
              and functional validation across releases, turning implicit
              knowledge into something the team could inherit.
            </p>
          </li>
          <li class='flex-layout column gap'>
            <span class='responsibility-label'>Gap coverage</span>
            <h5 class='emphasized'>Backend & Infrastructure Support</h5>
            <p>
              When product-critical gaps appeared, I traced cross-stack data,
              fixed high-risk backend paths, supported deployment and CI work,
              and gave stakeholders evidence-based options, not just status.
            </p>
          </li>
        </ul>
      </div>

      <div
        id='hands-on'
        class='container padded content-wrapper flex-layout column gap'
      >
        <span class='chapter-label'>The hard part happens between screens</span>
        <h3>Building a Resilient Live Platform</h3>
        <p>
          A live COMET session is a coordinated system: an operator controls a
          sequence while many participants make energy choices, receive updates,
          transition between simulations and complete billing. I designed and
          built the frontend around the moments where distributed systems most
          often become visible to users-latency, reconnection, stale state and
          partial completion.
        </p>

        <ol class='simulation-flow' aria-label='Live simulation lifecycle'>
          <li>
