---
import Link from '@/components/links/Link.astro';
import BaseLayout from '@layouts/BaseLayout.astro';

const title = '404 | Page Not Found';
const description = 'The page you are looking for does not exist.';
---

<BaseLayout title={title} description={description}>
  <div class='container padded flex-layout column justify-center gap'>
    <h1>404</h1>
    <p class='subtitle'>The page you are looking for does not exist.</p>
    <Link variant='secondary' href='/' class='go-home-link'
      >Go to Main Page</Link
    >
  </div>
</BaseLayout>

<style>
  .container {
    height: 100%;
    flex-grow: 1;
    align-items: start;
  }

  .subtitle {
    margin-bottom: var(--space-md);
  }
</style>
