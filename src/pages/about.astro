---
import CTA from '@/components/page-sections/CTA.astro';
import ProfessionalTimeline from '@/components/page-sections/about/ProfessionalTimeline.svelte';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SiteName } from '@/utils/Constants.astro';
import Image from 'astro/components/Image.astro';
import MyPhoto from '@assets/ahmed-halftone.webp';

const title = `About | ${SiteName}`;
const description = `Learn more about me, my background and my career.`;
---

<BaseLayout title={title} description={description}>
  <section id='me' class='about-me flex-layout column'>
    <div
      class='about-me-content container padded intro grid-layout horizontal three-cols gap gap-2xl'
    >
      <div class='my-photo span-1'>
        <span class='slash'></span>
        <Image src={MyPhoto} alt=`${SiteName}` loading={'eager'} />
      </div>
      <div class='content way-started span-2 flex-layout column gap gap-lg'>
        <h3>The Way it Started!</h3>
        <p>
          My connection to design and technology began in elementary school,
          long before I ever touched a line of code. <span class='emphasized'
            >I started as a graphic designer</span
          >, crafting everything from school magazines to complex, animated
          presentations that pushed tools like Photoshop to their limits. By
          2013, <span class='emphasized'
            >my focus had fully shifted to the web</span
          >, evolving from static layouts into the high-performance applications
          I lead today.
        </p>
      </div>
    </div>

    <div class='about-me the-challenge full-bleed'>
      <div
        class='about-me-content container padded grid-layout two-cols align-start'
      >
        <div class='content flex-layout column gap'>
          <h3>Atypical Journey</h3>
          <p>
            My path through <span class='emphasized'
              >medicine was a divergence of discipline</span
            >. I accepted the challenge of a medical degree initially as a
            career goal, and later as a test of my own capability. After
            graduating with distinction, <span class='emphasized'
              >I chose to make my final move toward design from a "mountain’s
              summit" rather than a valley</span
            >, proving that my shift was driven by passion, not an escape.
          </p>
          <p>
            Knowing that passion alone wasn't enough to lead at the highest
            level, I chose to pursue a Bachelor’s in <span class='emphasized'
              >Visual Arts Technology as a second challenge</span
            >, ensuring I possessed the formal core knowledge required to bridge
            gaps between logic and creativity.
          </p>
        </div>

        <div class='content flex-layout column gap'>
          <h3>The Way Forward...</h3>
          <p>
            This journey ingrained in me a "high-stakes" precision, analytical
            rigor and an unwavering diligence. As a designer, front-end
            developer and leader, <span class='emphasized'
              >I prioritize compassion, empathy, and deep ownership</span
            >, fostering environments where top-tier performance stems from
            mutual respect.
          </p>
          <p>
            This dedication has earned me <span class='emphasized'
              >significant independence</span
            > from CEOs, founders and managers, providing a level of trust I've maintained
            for 10+ years by consistently <span class='emphasized'
              >bridging the gap between stakeholder's high-level vision and
              meticulous, hands-on functional design and code</span
            >.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section id='skills' class='skills full-bleed'>
    <div class='skills-content container padded flex-layout column gap gap-lg'>
      <h2>Skills</h2>

      <div class='lists-grid grid-layout horizontal three-cols gap gap-lg'>
        <div class='skills-list flex-layout column gap justify-start'>
          <h4>Product Strategy</h4>
          <ul>
            <li>Vision</li>
            <li>Roadmapping</li>
            <li>Value-driven prioritization</li>
            <li>Cross-functional alignment</li>
          </ul>
        </div>

        <div class='skills-list flex-layout column gap justify-start'>
          <h4>UX/UI Design</h4>
          <ul>
            <li>User research</li>
            <li>Prototyping</li>
            <li>Design systems</li>
            <li>Interaction and motion</li>
          </ul>
        </div>

        <div class='skills-list flex-layout column gap justify-start'>
          <h4>Frontend Development</h4>
          <ul>
            <li>HTML, CSS, SASS</li>
            <li>JavaScript, TypeScript, Twig</li>
            <li>React, Svelte, Astro</li>
            <li>Redux Toolkit</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section id='career-timeline' class='container padded'>
    <ProfessionalTimeline client:load concise={false} orientation='vertical' />
  </section>

  <CTA />
</BaseLayout>

<style>
  .about-me {
    .about-me-content {
      min-height: 50lvh;

      > .content {
        justify-content: center;
        overflow: hidden;

        > p {
          color: var(--text-muted);
          max-width: 75ch;

          .emphasized {
            color: var(--text-secondary);
            font-weight: var(--font-weight-semibold);
          }
        }
      }

      @media (min-width: 769px) {
        > .way-started {
          padding-inline-end: var(--space-2xl);
        }
      }

      @media (min-width: 600px) and (max-width: 768px) {
        > .way-started {
          padding-block-end: var(--space-2xl);
        }
      }

      &.intro {
        height: 55lvh;
        min-height: fit-content;

        h3 {
          padding-block-start: var(--space-xl);
        }

        @media (max-width: 600px) {
          > .content {
            padding-block-start: var(--space-2xl);
            grid-row: 1;
            height: fit-content;
          }

          h3 {
            padding-block-start: 0;
          }

          .my-photo {
            grid-raw: 2;
            max-height: 24rem;
          }
        }
      }
    }

    &.the-challenge {
      background-color: var(--surface-1);

      .about-me-content {
        > .content {
          padding: var(--space-2xl) 0;
        }

        @media (min-width: 601px) {
          gap: var(--space-2xl);
        }
      }
    }
  }

  .my-photo {
    height: 100%;
    width: 100%;
    min-height: 16rem;
    position: relative;
    display: flex;
    justify-content: center;
    align-items: end;
    aspect-ratio: 1;
    overflow: hidden;

    .slash {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      color: var(--surface-1);
      z-index: -1;
    }

    img {
      margin-block-start: auto;
      min-width: 100%;
      max-height: 100%;
      object-fit: contain;

      [data-theme='dark'] & {
        filter: brightness(0.85) saturate(0.9) contrast(1.05);
      }
    }
  }

  .skills {
    background-color: var(--surface-2);
  }

  .skills-content {
    padding-block-start: max(10vh, var(--space-xl));
    padding-block-end: max(10vh, var(--space-xl));

    .skills-list {
      padding: var(--space-lg);
      background-color: var(--surface-0);

      h4 {
        color: var(--text-secondary);
      }

      ul {
        list-style: square;
        list-style-position: outside;
        padding-inline-start: var(--space-md);

        li {
          padding-inline-start: var(--space-xs);

          &:not(:last-of-type) {
            margin-block-end: var(--space-xs);
          }
        }
      }
    }
  }
</style>
