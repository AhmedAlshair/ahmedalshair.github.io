---
function getImage(arg0: { src: ImageMetadata; format: string }) {
  throw new Error('Function not implemented.');
}

import BaseLayout from '@layouts/BaseLayout.astro';
import { JobTitle, MetaDescription, SiteName } from '@/utils/Constants.astro';
import Icon from '@/components/Icon.svelte';
import Link from '@/components/links/Link.astro';
import FeaturedWorksSection from '@/components/page-sections/works/FeaturedWorksSection.astro';
import FeaturedWork from '@/components/page-sections/works/FeaturedWork.astro';
import CometWorkCover from '@assets/works/comet/work-cover-comet.jpg';
import PharmaWorkCover from '@assets/works/pharma/work-cover-pharma.jpg';
import ProfessionalTimeline from '@/components/page-sections/about/ProfessionalTimeline.svelte';
import CTA from '@/components/page-sections/CTA.astro';
import Testimonials from '@/components/Testimonials.svelte';
import EssamAvatar from '@assets/avatars/essam-rabah.png';
import IhtashamAvatar from '@assets/avatars/muhammad-ihtasham.png';
import RafaelAvatar from '@assets/avatars/rafael-adel.png';
import { optimizeImages } from '@/utils/Helpers.astro';

const title = `${SiteName} | ${JobTitle}`;

const [optimizedEssamAvatar, optimizedIhtashamAvatar, optimizedRafaelAvatar] =
  await optimizeImages([EssamAvatar, IhtashamAvatar, RafaelAvatar]);

const TestimonialsData = [
  {
    name: 'Muhammad Ihtasham Arif',
    role: 'Software Engineer',
    text: 'Ahmed is a skilled communicator who effectively manages teams and stakeholders. He has a keen ability to identify and mitigate risks while ensuring that project objectives are met on time. Ahmed is also an excellent problem-solver who remains calm under pressure and makes data-driven decisions. As a human being, he is a really kind and gentle person. I really look forward to working with him again in the future. ',
    avatar: {
      src: optimizedIhtashamAvatar.src,
    },
  },
  {
    name: 'Rafael Adel',
    role: 'Software Engineer',
    text: 'Ahmed was one of the most innovative and motivated colleagues I have worked with. His willingness to know more and to improvise solutions played as a great driving force for us. He always adds a sense of professionalism and decency to the workplace. I would really recommend Ahmed to any place to work with.',
    avatar: {
      src: optimizedRafaelAvatar.src,
    },
  },
  {
    name: 'Essam Rabah',
    role: 'Head of Product Design',
    text: `It’s rare that you come across standout talent like Shair's, I had the pleasure of working with Ahmed for at "The Seven Layers" and "The Tipping Point" Joint Venture, Shair's ability to juggle multiple projects was unlike any I've seen before and made a dramatic difference in the productivity level of our team and we still miss him in the office, In words (Bold, Committed and Talented). Thank you, Ahmed you earn my highest recommendation.`,
    avatar: {
      src: optimizedEssamAvatar.src,
    },
  },
];
---

<BaseLayout title={title} description={MetaDescription}>
  <section
    id='hero'
    class='hero container padded flex-layout column justify-center gap gap-lg'
  >
    <div class='hero-title'>
      <h1 class='title-1' aria-label='Design-driven Problem Solving'>
        Design-driven Problem Solving
      </h1>
      <h1 class='title-2' aria-label='Hands-on Code Level Craft'>
        Hands-on Code Level Craft
      </h1>
      <span class='slash mask-before'></span>
    </div>

    <p class='subtitle'>
      10+ years leading product, UX/UI, and engineering efforts to turn
      real-world problems into simple, impactful solutions. Currently leading at
      <a
        href='https://www.cometapp.net'
        target='_blank'
        rel='noopener noreferrer'
        class='emphasized'>COMET</a
      >.
    </p>
  </section>

  <section
    id='expertise'
    class='expertise container padded grid-layout horizontal three-cols gap gap-lg align-stretch'
  >
    <div class='exp product flex-layout column gap'>
      <div class='exp-title wrapper flex-layout gap align-center justify-start'>
        <Icon name='category' className='exp-icon' />
        <h3>Product Leadership</h3>
      </div>
      <p>
        Defining vision, mapping business goals to technical scoped tasks, and
        aligning cross-functional teams to deliver results.
      </p>
    </div>

    <div class='exp ux flex-layout column gap'>
      <div class='exp-title wrapper flex-layout gap align-center justify-start'>
        <Icon name='design_services' className='exp-icon' />
        <h3>User Experience</h3>
      </div>
      <p>
        Solving complex business problems through research-driven UIs,
        prototyping, user testing and design systems.
      </p>
    </div>

    <div class='exp frontend flex-layout column gap'>
      <div class='exp-title wrapper flex-layout gap align-center justify-start'>
        <Icon name='code_blocks' className='exp-icon' />
        <h3>Front-end Craft</h3>
      </div>
      <p>
        Building performant web apps and services using modern frameworks like <span
          class='meta-label code'>Astro</span
        >, <span class='meta-label code'>Svelte</span> and <span
          class='meta-label code'>React</span
        > among others.
      </p>
    </div>
  </section>

  <FeaturedWorksSection>
    <FeaturedWork
      title='COMET: Scaling a Complex Impact-First SaaS Product'
      description='Leading the 5-year strategic evolution of a complex simulation engine from an offline field tool to a scalable, cloud-based SaaS solution.'
      image={CometWorkCover}
      imageAlt='Comet Screenshot'
      linkUrl='/works/comet'
      linkText='Read the Case Study'
    />

    <FeaturedWork
      title='Customized Experiences for Pharma & Healthcare Leaders'
      description='Delivering interactive healthcare-focused CLM experiences, websites and mobile apps handling complex data visualization and strict compliance workflows.'
      image={PharmaWorkCover}
      imageAlt='Pharma Work Screenshot'
      linkUrl='/works/pharma'
      linkText='Explore Projects'
      reverse
    />
  </FeaturedWorksSection>

  <section id='career-timeline' class='container padded'>
    <ProfessionalTimeline client:load concise={true} />
    <div class='timeline-learn-more'>
      <Link variant='secondary' href='/about'>Learn more about me</Link>
    </div>
  </section>

  <section class='testimonials flex-layout column gap gap-xl'>
    <h2>Testimonials</h2>
    <Testimonials client:visible testimonials={TestimonialsData} />
  </section>

  <CTA />
</BaseLayout>

<style>
  .hero {
    position: relative;
    min-height: 80lvh;
    padding-block-start: max(12vh, var(--space-xl));
    padding-block-end: max(12vh, var(--space-xl));
    width: 100%;
    gap: var(--space-md);

    @media (orientation: portrait) {
      min-height: fit-content;
    }

    .hero-title {
      position: relative;
      display: flex;
      align-items: center;
      flex-wrap: nowrap;
      min-height: fit-content;
      overflow: hidden;

      > h1 {
        position: absolute;
        left: 0;
        top: 0;
        margin: 0;
        width: fit-content;
        height: 100%;
        padding: 0 clamp(4rem, 5vw, 6rem);
        visibility: hidden;
        animation-fill-mode: both;
        will-change: transform, visibility;

        display: flex;
        align-items: center;

        @media (max-width: 600px) {
          font-size: var(--font-size-h2);
        }

        @media (max-width: 400px) {
          font-size: var(--font-size-h3);
        }

        @media (max-width: 300px) {
          font-size: var(--font-size-h4);
        }

        &.title-1 {
          animation: slideInLeft var(--cycle) ease-in-out 0s infinite;
        }

        &.title-2 {
          animation: slideInLeft var(--cycle) ease-in-out
            calc(var(--stagger) * -1) infinite;
        }
      }

      > .slash {
        width: clamp(3rem, 4vw, 4rem);
        height: clamp(7rem, 8vw, 8rem);
        animation: slash-in 0.3s ease 0.3s backwards;
        z-index: 1;
      }
    }

    .subtitle {
      text-wrap: balance;
      hyphens: auto;
    }

    .actions {
      padding: var(--space-md) 0;
    }
  }

  .expertise {
    min-height: fit-content;
    padding-bottom: max(15vh, var(--space-2xl));

    @media (orientation: portrait) {
      min-height: fit-content;
    }

    @media (max-width: 600px) {
      flex-wrap: wrap;
    }

    .exp {
      padding: var(--space-md) var(--space-md) var(--space-lg);
      background-color: var(--surface-1);
    }

    .exp-title {
      @media (max-width: 768px) {
        flex-wrap: wrap;
      }

      h3 {
        margin: 0;
      }

      .exp-icon {
        align-self: start;
        padding: var(--space-xs);
        background-color: var(--surface-0);
        aspect-ratio: 1;
        color: var(--accent);
        font-size: var(--icon-lg);
      }
    }

    p {
      flex-grow: 1;
      color: var(--text-muted);
    }
  }

  @keyframes slash-in {
    from {
      opacity: 0;
      transform: translateX(100%);
    }
  }

  .timeline-learn-more {
    min-height: 15lvh;
    padding-block-end: max(10vh, var(--space-xl));

    @media (orientation: portrait) {
      min-height: fit-content;
    }
  }

  .testimonials {
    padding-block-start: var(--space-2xl);
    padding-block-end: var(--space-3xl);

    @media (min-width: 601px) {
      max-width: var(--max-width);
      padding-inline: var(--container-padding);
      margin-inline: auto;
    }

    @media (max-width: 600px) {
      h2 {
        padding-inline: var(--container-padding);
      }
    }
  }
</style>

<script>
  // Animation configuration (seconds)
  const animationConfig = {
    preDelay: 0.4, // time before title enters
    enterDuration: 0.4, // enter animation duration
    holdDuration: 5, // title stays visible
    exitDuration: 0.4, // exit animation duration
    postDelay: 0.1, // off-screen time after exit until next cycle
  };

  const activeDuration =
    animationConfig.preDelay +
    animationConfig.enterDuration +
    animationConfig.holdDuration +
    animationConfig.exitDuration;
  const totalDuration = activeDuration * 2 + animationConfig.postDelay;

  function generateDynamicKeyframes() {
    const heroTitle = document.querySelector('.hero-title') as HTMLElement;
    if (!heroTitle) return;

    // Convert durations to percentages of total cycle
    const preDelayPct = Math.round(
      ((animationConfig.preDelay + animationConfig.postDelay) / totalDuration) *
        100,
    );
    const enterEndPct = Math.round(
      (animationConfig.enterDuration / totalDuration) * 100 + preDelayPct,
    );
    const holdEndPct = Math.round(
      ((animationConfig.preDelay +
        animationConfig.enterDuration +
        animationConfig.holdDuration) /
        totalDuration) *
        100,
    );
    const exitEndPct = Math.round((activeDuration / totalDuration) * 100);

    const keyframesCSS = `
      @keyframes slideInLeft {
        0% {
          transform: translateX(-80%);
          visibility: hidden;
        }
        ${preDelayPct}% {
            transform: translateX(-80%);
            visibility: hidden;
        }
        ${enterEndPct}% {
          transform: translateX(0);
          visibility: visible;
        }
        ${holdEndPct}% {
          transform: translateX(0);
          visibility: visible;
        }
        ${exitEndPct}% {
          transform: translateX(-100%);
          visibility: hidden;
        }
        100% {
          transform: translateX(-100%);
        }
      }
    `;

    let styleTag = document.getElementById('dynamic-keyframes');
    if (!styleTag) {
      styleTag = document.createElement('style');
      styleTag.id = 'dynamic-keyframes';
      document.head.appendChild(styleTag);
    }
    styleTag.textContent = keyframesCSS;

    // Apply animation durations to elements and compute stagger so the second
    // title enters after the first has completed its exit (no overlap).
    heroTitle.style.setProperty('--cycle', `${totalDuration}s`);
    heroTitle.style.setProperty('--stagger', `${activeDuration}s`);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', generateDynamicKeyframes);
  } else {
    generateDynamicKeyframes();
  }
</script>
