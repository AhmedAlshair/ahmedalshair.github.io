---
import BaseLayout from '@layouts/BaseLayout.astro';
import { JobTitle, MetaDescription, SiteName } from '@/utils/Constants.astro';
import Icon from '@/components/Icon.svelte';
import Link from '@/components/links/Link.astro';
import FeaturedWorksSection from '@/components/page-sections/works/FeaturedWorksSection.astro';
import FeaturedWork from '@/components/page-sections/works/FeaturedWork.astro';
import PharmaWorkCover from '@assets/works/pharma/work-cover-pharma.jpg';
import ProfessionalTimeline from '@/components/page-sections/about/ProfessionalTimeline.svelte';
import CTA from '@/components/page-sections/CTA.astro';
import Testimonials from '@/components/Testimonials.svelte';
import EssamAvatar from '@assets/avatars/essam-rabah.png';
import IhtashamAvatar from '@assets/avatars/muhammad-ihtasham.png';
import RafaelAvatar from '@assets/avatars/rafael-adel.png';
import { optimizeImages } from '@/utils/Helpers.astro';
import { Image } from 'astro:assets';
import CometDashboard from '@assets/works/comet/comet-saas-carousel-7.png';
import AlrevhairWorkCover from '@assets/works/work-cover-alrevhair.jpg';
import HeroMotionToggle from '@/components/HeroMotionToggle.svelte';

const title = `${SiteName} | ${JobTitle}`;

const [optimizedEssamAvatar, optimizedIhtashamAvatar, optimizedRafaelAvatar] = await optimizeImages(
  [EssamAvatar, IhtashamAvatar, RafaelAvatar],
);

const TestimonialsData = [
  {
    name: 'Muhammad Ihtasham Arif',
    role: 'Software Engineer',
    text: 'Ahmed is a skilled communicator who effectively manages teams and stakeholders. He has a keen ability to identify and mitigate risks while ensuring that project objectives are met on time. Ahmed is also an excellent problem-solver who remains calm under pressure and makes data-driven decisions. As a human being, he is a really kind and gentle person. I really look forward to working with him again in the future. ',
    avatar: {
      src: optimizedIhtashamAvatar.src,
    },
  },
  {
    name: 'Rafael Adel',
    role: 'Software Engineer',
    text: 'Ahmed was one of the most innovative and motivated colleagues I have worked with. His willingness to know more and to improvise solutions played as a great driving force for us. He always adds a sense of professionalism and decency to the workplace. I would really recommend Ahmed to any place to work with.',
    avatar: {
      src: optimizedRafaelAvatar.src,
    },
  },
  {
    name: 'Essam Rabah',
    role: 'Head of Product Design',
    text: `It’s rare that you come across standout talent like Shair's, I had the pleasure of working with Ahmed for at "The Seven Layers" and "The Tipping Point" Joint Venture, Shair's ability to juggle multiple projects was unlike any I've seen before and made a dramatic difference in the productivity level of our team and we still miss him in the office, In words (Bold, Committed and Talented). Thank you, Ahmed you earn my highest recommendation.`,
    avatar: {
      src: optimizedEssamAvatar.src,
    },
  },
];
---

<BaseLayout title={title} description={MetaDescription}>
  <section id='hero' class='hero container padded' aria-labelledby='hero-heading'>
    <div class='hero-intro'>
      <div id='hero-process' class='hero-process'>
        <p class='sr-only'>Product Lead. UX Designer. Frontend Development.</p>
        <div class='hero-motion' aria-hidden='true'>
          <span class='slash mask-before'></span>
          <div class='hero-phrases'>
            <span>Product Lead</span>
            <span>UX Designer</span>
            <span>Frontend Development</span>
          </div>
        </div>

        <HeroMotionToggle client:load targetId='hero-process' hideButton={true} />
      </div>

      <h1 id='hero-heading'>
        I shape complex systems into <span>clear, useful products</span>
      </h1>

      <p class='hero-description'>
        For 10+ years, I’ve led work from opportunity discovery and product direction through UX
        design and hands-on frontend engineering.
      </p>

      <div class='hero-actions'>
        <Link href='/contact#form' variant='primary'>
          {' '}
          Let’s talk{' '}
        </Link>
        <Link href='#selected-works' variant='ghost' icon={null}>
          Explore my work
        </Link>
      </div>
    </div>

    <aside class='hero-project' aria-labelledby='hero-project-title'>
      <div class='hero-project-label'>
        <div class='meta-label'>
          Featured / <span class='emphasized'>COMET</span>
        </div>
        <span class='hero-project-category'>Energy &amp; Impact</span>
      </div>
      <a class='hero-project-image' href='/works/comet' aria-label='Explore the COMET case study'>
        <Image
          src={CometDashboard}
          alt='COMET simulation report showing energy insights and participant outcomes'
          widths={[480, 800, 1200]}
          sizes='(max-width: 600px) calc(100vw - 48px), (max-width: 1000px) min(672px, calc(100vw - 96px)), 465px'
          loading='eager'
          fetchpriority='high'
        />
      </a>
      <div class='hero-project-story'>
        <h4 id='hero-project-title'>Designing and building a collaborative energy-planning SaaS</h4>
        <ul class='hero-project-impact' aria-label='COMET case study highlights'>
          <li>
            <strong>2020 - Present</strong>
            <span>Product direction, UX/UI &amp; frontend</span>
          </li>
          <li>
            <strong>~3 years</strong>
            <span>SaaS design &amp; development</span>
          </li>
          <li>
            <strong>ASU + UNDP</strong>
            <span>Recognition &amp; partnerships</span>
          </li>
        </ul>
        <Link href='/works/comet' variant='secondary'>
          Read the case study
        </Link>
      </div>
    </aside>
  </section>

  <section
    id='expertise'
    class='expertise container padded grid-layout horizontal three-cols gap gap-lg align-stretch'
  >
    <div class='exp product flex-layout column gap'>
      <div class='exp-title wrapper flex-layout column gap'>
        <Icon name='category' className='exp-icon' />
        <h3>Product Leadership</h3>
      </div>
      <p>
        Defining vision, mapping business goals to technical scoped tasks, and aligning
        cross-functional teams to deliver results.
      </p>
    </div>

    <div class='exp ux flex-layout column gap'>
      <div class='exp-title wrapper flex-layout column gap'>
        <Icon name='design_services' className='exp-icon' />
        <h3>User Experience</h3>
      </div>
      <p>
        Solving complex business problems through research-driven UIs, prototyping, user testing and
        design systems.
      </p>
    </div>

    <div class='exp frontend flex-layout column gap'>
      <div class='exp-title wrapper flex-layout column gap'>
        <Icon name='code_blocks' className='exp-icon' />
        <h3>Front-end Craft</h3>
      </div>
      <p>
        Building performant web apps and services using modern frameworks like{' '}
        <span class='meta-label code'>Astro</span>, <span class='meta-label code'>Svelte</span> and{' '}
        <span class='meta-label code'>React</span> among others.
      </p>
    </div>
  </section>

  <div id='selected-works' class='selected-work'>
    <FeaturedWorksSection>
      <FeaturedWork
        title='Customized Experiences for Pharma & Healthcare Leaders'
        description='Delivering interactive healthcare-focused CLM experiences, websites and mobile apps handling complex data visualization and strict compliance workflows.'
        image={PharmaWorkCover}
        imageAlt='Pharma Work Screenshot'
        linkUrl='/works/pharma'
        linkText='Explore Projects'
        reverse
      />
      <FeaturedWork
        title='Alrevhair: Website Design for Hair Transplant Center'
        description='An inclusive international experience of trust, quality and pleasure that puts customers at ease and helps them make informed decisions right from their home countries.'
        image={AlrevhairWorkCover}
        imageAlt='Pharma Work Screenshot'
        linkUrl='https://www.behance.net/gallery/99695209/AlrevHair-Website-Design'
        linkText='View Case Study'
        linkTarget='_blank'
      />
    </FeaturedWorksSection>
  </div>

  <section id='career-timeline' class='container padded'>
    <ProfessionalTimeline client:load concise={true} />
    <div class='timeline-learn-more'>
      <Link variant='secondary' href='/about'>
        {' '}
        Learn more about me{' '}
      </Link>
    </div>
  </section>

  <section id='testimonials' class='flex-layout column gap gap-xl'>
    <h2>Testimonials</h2>
    <Testimonials client:visible testimonials={TestimonialsData} />
  </section>

  <CTA />
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(2rem, 4vw, 4rem);
    padding-block: clamp(1.5rem, 4vh, 3.5rem) clamp(4rem, 8vh, 6rem);
  }

  .hero-intro {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-lg);
    min-width: 0;
  }

  .hero-roles {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-sm);
    color: var(--text-secondary);
    font-size: 0.8125rem;
    font-weight: var(--font-weight-semibold);

    span + span::before {
      content: '/';
      margin-inline-end: var(--space-sm);
      color: var(--accent);
    }
  }

  .hero h1 {
    max-width: 15ch;
    font-size: clamp(2.5rem, 4.5vw, 3.5rem);
    line-height: 1.1;
    letter-spacing: -0.055em;
    text-wrap: pretty;

    span {
      color: var(--accent);
    }
  }

  .hero-description {
    max-width: 46ch;
    color: var(--text-muted);
    font-size: 1.125rem;
    text-wrap: pretty;
  }

  .hero-process {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    width: 100%;
  }

  .hero-motion {
    --hero-slash-width: 0.8em;
    --hero-slash-edge-bottom: 0.267em;

    display: flex;
    align-items: center;
    min-width: 0;
    gap: 0;
    font-family: var(--font-headings);
    font-size: clamp(1rem, 1.7vw, 1.1875rem);
    font-weight: var(--font-weight-semibold);

    .slash {
      width: var(--hero-slash-width);
      min-width: var(--hero-slash-width);
      height: 2em;
      z-index: 1;
    }
  }

  .hero-phrases {
    display: grid;
    align-items: center;
    height: 2em;
    margin-inline-start: calc(0px - var(--hero-slash-width));
    padding-inline-start: calc(var(--hero-slash-width) + var(--space-sm));
    overflow: hidden;
    clip-path: polygon(
      var(--hero-slash-width) 0,
      100% 0,
      100% 100%,
      var(--hero-slash-edge-bottom) 100%
    );

    span {
      grid-area: 1 / 1;
      visibility: hidden;
    }

    span:first-child {
      visibility: visible;
    }
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    width: 100%;
  }

  .hero-project {
    min-width: 0;
    border: var(--stroke-width-thin) solid var(--border-color);
    background-color: var(--surface-1);

    h4 {
      text-wrap: pretty;
    }
  }

  .hero-project-label {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-xs);
    padding: var(--space-sm) var(--space-lg);
    font-size: 0.75rem;
    color: var(--text-secondary);
  }

  .hero-project-category {
    color: var(--text-muted);
  }

  .hero-project-image {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-block: var(--stroke-width-thin) solid var(--border-color);

    img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: top;
      transition: transform var(--transition-slow);
      transform-origin: top;
    }

    &:hover img {
      transform: scale(1.02);
    }
  }

  .hero-project-story {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-sm);
    padding: var(--space-lg);

    p {
      color: var(--text-muted);
      font-size: 0.9375rem;
    }

    .hero-project-role {
      font-size: 0.75rem;
      color: var(--accent);
      font-weight: var(--font-weight-semibold);
    }

    .hero-project-impact {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      width: 100%;

      li {
        display: flex;
        flex-direction: column;
        gap: var(--space-2xs);
        min-width: 0;
        padding: var(--space-sm) var(--space-sm) var(--space-sm) 0;

        & + li {
          border-inline-start: var(--stroke-width-thin) solid var(--border-color);
          padding-inline-start: var(--space-md);
        }
      }

      strong {
        color: var(--text-primary);
        font-family: var(--font-headings);
        font-size: 0.875rem;
        line-height: var(--lh-tight);
      }

      span {
        color: var(--text-muted);
        font-size: 0.75rem;
        line-height: var(--lh-tight);
      }
    }

    :global(a.link.ghost) {
      padding-inline: 0;
    }

    :global(a.link.ghost .link-text) {
      margin-inline-start: 0;
    }
  }

  .selected-work {
    width: 100%;
    scroll-margin-top: calc(var(--header-height) + var(--space-lg));
  }

  @media (max-width: 1000px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-xl);
    }

    .hero-project {
      width: 100%;
      max-width: 42rem;
      justify-self: center;
    }
  }

  @media (max-width: 600px) {
    .hero {
      padding-block: var(--space-xl) var(--space-2xl);
    }

    .hero-intro {
      gap: var(--space-md);
    }

    .hero-description {
      font-size: 1rem;
    }

    .hero-actions {
      :global(a.link) {
        width: 100%;
        font-size: 0.9375rem;
      }
    }

    .hero-project-label,
    .hero-project-story {
      padding-inline: var(--space-md);
    }

    .hero-project-impact {
      li {
        padding-inline: var(--space-2xs);
      }

      strong {
        font-size: 0.8125rem;
      }
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-process.is-animated .hero-phrases span {
      animation: hero-phrase 15s ease-in-out infinite both;

      &:nth-child(2) {
        animation-delay: 5s;
      }

      &:nth-child(3) {
        animation-delay: 10s;
      }
    }

    .hero-process.is-paused .hero-phrases span {
      animation-play-state: paused;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-project-image:hover img {
      transform: none;
    }
  }

  @keyframes hero-phrase {
    0% {
      visibility: visible;
      transform: translateX(-130%);
    }
    1.333%,
    32.667% {
      visibility: visible;
      transform: translateX(0);
    }
    34% {
      visibility: visible;
      transform: translateX(-130%);
    }
    34.001%,
    100% {
      visibility: hidden;
      transform: translateX(-130%);
    }
  }

  .expertise {
    min-height: fit-content;
    padding-block-start: max(12vh, var(--space-2xl));
    padding-block-end: max(16vh, var(--space-3xl));

    @media (orientation: portrait) {
      min-height: fit-content;
    }

    @media (max-width: 600px) {
      flex-wrap: wrap;
    }

    .exp {
      padding: var(--space-md) var(--space-md) var(--space-lg);
      background-color: var(--surface-1);
    }

    .exp-title {
      @media (max-width: 768px) {
        flex-wrap: wrap;
      }

      h3 {
        margin: 0;
      }

      .exp-icon {
        align-self: start;
        padding: var(--space-xs);
        background-color: var(--surface-0);
        aspect-ratio: 1;
        color: var(--accent);
        font-size: var(--icon-lg);
        max-width: 2em;
        max-height: 2em;
        text-align: center;
      }
    }

    p {
      flex-grow: 1;
      color: var(--text-muted);
    }
  }

  .timeline-learn-more {
    min-height: 15lvh;
    padding-block-end: max(10vh, var(--space-xl));

    @media (orientation: portrait) {
      min-height: fit-content;
    }
  }

  #testimonials {
    max-width: min(var(--max-width), 100%);
    padding-block-start: var(--space-2xl);
    padding-block-end: var(--space-3xl);

    @media (min-width: 601px) {
      padding-inline: var(--container-padding);
      margin-inline: auto;
    }

    @media (max-width: 600px) {
      h2 {
        padding-inline: var(--container-padding);
      }
    }
  }
</style>
